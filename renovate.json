{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Group Docker image updates (Dockerfile + docker-compose)",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker images"
    },
    {
      "description": "Group Helm chart dependency and values updates",
      "matchManagers": ["helmv3", "helm-values"],
      "groupName": "Helm charts"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  }
}
